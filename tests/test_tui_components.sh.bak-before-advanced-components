#!/bin/bash
# TUI 组件渲染测试脚本
# R2027: 修复静默失败——多行 --eval 只执行第一行，改用 progn 包裹
# R2027: 组件渲染用 -l 临时 .el 文件执行，确保 message 正确输出

echo "=== TUI 组件渲染测试开始 ==="

cd ~/aiaos/aiaos-cli

# 测试 1: 加载所有 TUI 模块
echo ""
echo "--- 测试 1: 加载 TUI 模块 ---"
emacs --batch -L elisp --eval '(progn
(load "aiaos-cli-core")
(load "aiaos-cli-state")
(load "aiaos-cli-context")
(load "aiaos-cli-lifecycle")
(load "aiaos-cli-theme")
(load "aiaos-cli-component")
(load "aiaos-cli-components")
(load "aiaos-cli-router")
(load "aiaos-cli-app")
(message "PASS: 所有 TUI 模块加载成功"))
' 2>&1

# 测试 2: 组件渲染测试（用临时 .el 文件 + -l 执行）
echo ""
echo "--- 测试 2: 组件渲染测试 ---"
cat > /tmp/tui_component_test-$$.el << 'ELISP'
(progn
  (load "aiaos-cli-components")

  (let ((test-buffer (get-buffer-create "*tui-test*")))
    (with-current-buffer test-buffer
      (erase-buffer)

      ;; 文本组件
      (let ((comp (aiaos-cli-component-text "Hello World")))
        (funcall (aiaos-cli--component-render comp) (current-buffer))
        (if (string-match-p "Hello World" (buffer-string))
            (message "PASS: 文本组件")
            (message "FAIL: 文本组件 - 输出: %S" (buffer-string))))

      (erase-buffer)

      ;; 边框组件
      (let ((comp (aiaos-cli-component-border "Title" "Content")))
        (funcall (aiaos-cli--component-render comp) (current-buffer))
        (let ((output (buffer-string)))
          (if (and (string-match-p "Title" output) (string-match-p "Content" output))
              (message "PASS: 边框组件")
              (message "FAIL: 边框组件 - 输出: %S" output))))

      (erase-buffer)

      ;; 列表组件
      (let ((comp (aiaos-cli-component-list (list "item1" "item2" "item3"))))
        (funcall (aiaos-cli--component-render comp) (current-buffer))
        (let ((output (buffer-string)))
          (if (and (string-match-p "item1" output) (string-match-p "item3" output))
              (message "PASS: 列表组件")
              (message "FAIL: 列表组件 - 输出: %S" output))))

      (erase-buffer)

      ;; 表格组件
      (let ((comp (aiaos-cli-component-table (list "Name" "Value") (list (list "a" "1") (list "b" "2")))))
        (funcall (aiaos-cli--component-render comp) (current-buffer))
        (let ((output (buffer-string)))
          (if (and (string-match-p "Name" output) (string-match-p "b" output))
              (message "PASS: 表格组件")
              (message "FAIL: 表格组件 - 输出: %S" output))))

      (erase-buffer)

      ;; 进度条组件
      (let ((comp (aiaos-cli-component-progress 50 100 "Loading")))
        (funcall (aiaos-cli--component-render comp) (current-buffer))
        (let ((output (buffer-string)))
          (if (string-match-p "50%" output)
              (message "PASS: 进度条组件")
              (message "FAIL: 进度条组件 - 输出: %S" output))))

      (erase-buffer)

      ;; 状态栏组件
      (let ((comp (aiaos-cli-component-statusbar "Left" "Right")))
        (funcall (aiaos-cli--component-render comp) (current-buffer))
        (let ((output (buffer-string)))
          (if (and (string-match-p "Left" output) (string-match-p "Right" output))
              (message "PASS: 状态栏组件")
              (message "FAIL: 状态栏组件 - 输出: %S" output))))

      (erase-buffer)

      ;; 垂直布局
      (let ((comp (aiaos-cli-component-vertical
                   (aiaos-cli-component-text "Top")
                   (aiaos-cli-component-text "Bottom"))))
        (funcall (aiaos-cli--component-render comp) (current-buffer))
        (let ((output (buffer-string)))
          (if (and (string-match-p "Top" output) (string-match-p "Bottom" output))
              (message "PASS: 垂直布局")
              (message "FAIL: 垂直布局 - 输出: %S" output))))

      (erase-buffer)

      ;; 标签页组件
      (let ((comp (aiaos-cli-component-tabs (list "Tab1" "Tab2" "Tab3"))))
        (funcall (aiaos-cli--component-render comp) (current-buffer))
        (let ((output (buffer-string)))
          (if (and (string-match-p "Tab1" output) (string-match-p "Tab3" output))
              (message "PASS: 标签页组件")
              (message "FAIL: 标签页组件 - 输出: %S" output))))

      (erase-buffer)
    )
    (kill-buffer test-buffer))
  (message "TUI 组件渲染测试完成"))
ELISP
emacs --batch -L elisp -l /tmp/tui_component_test-$$.el 2>&1
rm -f /tmp/tui_component_test-$$.el

# 测试 3: 主题系统测试
echo ""
echo "--- 测试 3: 主题系统测试 ---"
emacs --batch -L elisp --eval '(progn
(load "aiaos-cli-theme")
(load "aiaos-cli-context")
(aiaos-cli--context-init)
(let ((theme (aiaos-cli--theme-current)))
  (if theme
      (message "PASS: 主题系统可用 - 主题: %S" (aiaos-cli--theme-name theme))
      (message "FAIL: 主题系统不可用"))))
' 2>&1

# 测试 4: 状态管理测试
echo ""
echo "--- 测试 4: 状态管理测试 ---"
emacs --batch -L elisp --eval '(progn
(load "aiaos-cli-state")
(let ((state (aiaos-cli--state-create 0)))
  (if (= (aiaos-cli--state-get state) 0)
      (message "PASS: 状态管理可用")
      (message "FAIL: 状态管理不可用"))))
' 2>&1

# 测试 5: 路由系统测试
echo ""
echo "--- 测试 5: 路由系统测试 ---"
emacs --batch -L elisp --eval '(progn
(load "aiaos-cli-router")
(let ((route (aiaos-cli--router-create-route "home" "Home Page")))
  (if route
      (message "PASS: 路由注册 - path: %S" (aiaos-cli--route-path route))
      (message "FAIL: 路由注册失败"))))
' 2>&1

echo ""
echo "=== TUI 组件渲染测试完成 ==="
