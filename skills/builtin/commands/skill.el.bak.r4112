;;; R670: 新增缺失的 skill 子命令

(defun aiaos-cli-skill-builtin/skill-validate (args _options _ctx)
  "Validate a skill's metadata by checking skill.yaml."
  (let ((path (aiaos-cli--arg-value args "path")))
    (if (not path)
        (aiaos-cli--result-error "MISSING_ARG" "skill validate requires <path>")
      (let* ((skill-dir (if (file-directory-p path)
                            path
                          (expand-file-name path)))
             (manifest (expand-file-name "skill.yaml" skill-dir)))
        (cond
         ((not (file-directory-p skill-dir))
          (aiaos-cli--result-error "NOT_A_DIRECTORY"
                                   (format "Path is not a directory: %s" skill-dir)))
         ((not (file-exists-p manifest))
          (aiaos-cli--result-error "MISSING_MANIFEST"
                                   (format "No skill.yaml found in %s" skill-dir)))
         (t
          (let ((yaml-content (aiaos-cli-skill--read-yaml-file manifest)))
            (if (not yaml-content)
                (aiaos-cli--result-error "PARSE_ERROR"
                                         (format "Failed to parse skill.yaml in %s" skill-dir))
              (let* ((name (gethash "name" yaml-content))
                     (version (gethash "version" yaml-content))
                     (description (gethash "description" yaml-content))
                     (author (gethash "author" yaml-content))
                     (license (gethash "license" yaml-content))
                     (errors '())
                     (warnings '()))
                (unless name
                  (push "Missing 'name' field" errors))
                (unless version
                  (push "Missing 'version' field" errors))
                (unless description
                  (push "Missing 'description' field" warnings))
                (if errors
                    (aiaos-cli--result-error "VALIDATION_FAILED"
                                             (format "Skill validation failed:\n%s"
                                                     (mapconcat #'identity errors "\n")))
                  (aiaos-cli--result-success
                   :valid t
                   :name name
                   :version version
                   :description description
                   :author author
                   :license license
                   :warnings warnings
                   :output (format "Skill '%s' v%s is valid (with %d warnings)"
                                   name version (length warnings)))))))))))))

(defun aiaos-cli-skill-builtin/skill-run (args _options _ctx)
  "Run a skill's command by domain/action."
  (let ((domain (aiaos-cli--arg-value args "domain"))
        (action (aiaos-cli--arg-value args "action")))
    (if (or (not domain) (not action))
        (aiaos-cli--result-error "MISSING_ARG"
                                 "skill run requires <domain> <action>")
      (let ((cmd (aiaos-cli-find-command domain action)))
        (if (not cmd)
            (aiaos-cli--result-error "COMMAND_NOT_FOUND"
                                     (format "Command '%s/%s' not found" domain action))
          (let ((result (aiaos-cli-execute domain action '())))
            (aiaos-cli--result-success
             :domain domain
             :action action
             :result result
             :output (format "Executed %s/%s" domain action))))))))

(defun aiaos-cli-skill-builtin/skill-deps (args _options _ctx)
  "Show dependencies for loaded skills."
  (let* ((skill-name (aiaos-cli--arg-value args "name"))
         (skills (if skill-name
                     (list skill-name)
                   (mapcar (lambda (s) (aiaos-cli-skill-name s))
                           aiaos-cli--loaded-skills)))
         (deps-list '()))
    (dolist (name skills)
      (let ((skill (cl-find name aiaos-cli--loaded-skills
                            :test (lambda (s)
                                    (string= (aiaos-cli-skill-name s) name)))))
        (when skill
          (let ((meta (aiaos-cli-skill-metadata skill)))
            (when (and meta (listp meta))
              (let ((dep-entry (assq 'dependencies meta)))
                (when dep-entry
                  (dolist (dep (cdr dep-entry))
                    (push (list :skill name :dependency dep) deps-list)))))))))
    (aiaos-cli--result-success
     :dependencies deps-list
     :output (if deps-list
                 (format "Dependencies:\n%s"
                         (mapconcat (lambda (d)
                                      (format "  %s -> %s"
                                              (plist-get d :skill)
                                              (plist-get d :dependency)))
                                    deps-list "\n"))
               "No dependencies declared"))))

(defun aiaos-cli-skill-builtin/skill-create (args _options _ctx)
  "Create a skill skeleton directory with skill.yaml."
  (let ((name (aiaos-cli--arg-value args "name")))
    (if (not name)
        (aiaos-cli--result-error "MISSING_ARG" "skill create requires <name>")
      (let* ((base-dir (expand-file-name "~/.config/aiaos/skills"))
             (skill-dir (expand-file-name name base-dir))
             (manifest (expand-file-name "skill.yaml" skill-dir)))
        (if (file-exists-p skill-dir)
            (aiaos-cli--result-error "SKILL_EXISTS"
                                     (format "Skill directory already exists: %s" skill-dir))
          (progn
            (make-directory skill-dir t)
            (with-temp-file manifest
              (insert (format "name: %s\nversion: 0.1.0\ndescription: A new skill\nauthor: user\nlicense: MIT\n"
                              name)))
            (aiaos-cli--result-success
             :name name
             :path skill-dir
             :manifest manifest
             :output (format "Created skill '%s' at %s" name skill-dir))))))))

(defun aiaos-cli-skill-builtin/skill-uninstall (args _options _ctx)
  "Uninstall a skill by removing it from the user skill dir."
  (let ((name (aiaos-cli--arg-value args "name")))
    (if (not name)
        (aiaos-cli--result-error "MISSING_ARG" "skill uninstall requires <name>")
      (let* ((base-dir (expand-file-name "~/.config/aiaos/skills"))
             (skill-dir (expand-file-name name base-dir)))
        (if (not (file-directory-p skill-dir))
            (aiaos-cli--result-error "SKILL_NOT_FOUND"
                                     (format "Skill directory not found: %s" skill-dir))
          (progn
            (delete-directory skill-dir t t)
            (setq aiaos-cli--loaded-skills
                  (cl-remove name aiaos-cli--loaded-skills
                             :test (lambda (s)
                                     (string= (aiaos-cli-skill-name s) name))))
            (aiaos-cli--result-success
             :name name
             :path skill-dir
             :output (format "Uninstalled skill '%s'" name))))))))

(defun aiaos-cli-skill-builtin/skill-update (args _options _ctx)
  "Update a skill from its source directory."
  (let ((name (aiaos-cli--arg-value args "name"))
        (path (aiaos-cli--arg-value args "path")))
    (if (not name)
        (aiaos-cli--result-error "MISSING_ARG" "skill update requires <name>")
      (let* ((base-dir (expand-file-name "~/.config/aiaos/skills"))
             (skill-dir (expand-file-name name base-dir)))
        (if (not (file-directory-p skill-dir))
            (aiaos-cli--result-error "SKILL_NOT_FOUND"
                                     (format "Skill directory not found: %s" skill-dir))
          (if (and path (file-directory-p path))
              (progn
                (delete-directory skill-dir t t)
                (copy-tree path skill-dir)
                (aiaos-cli--result-success
                 :name name
                 :updated t
                 :output (format "Updated skill '%s' from %s" name path)))
            (aiaos-cli--result-success
             :name name
             :updated t
             :output (format "Skill '%s' is already up to date (no source specified)" name))))))))

(defun aiaos-cli-skill-builtin/skill-search (args _options _ctx)
  "Search installed skills by name or description."
  (let ((query (aiaos-cli--arg-value args "query")))
    (if (not query)
        (aiaos-cli--result-error "MISSING_ARG" "skill search requires <query>")
      (let* ((base-dir (expand-file-name "~/.config/aiaos/skills"))
             (results '()))
        (when (file-directory-p base-dir)
          (cl-loop for dir in (directory-files base-dir t)
                   when (and (file-directory-p dir)
                             (string-match-p query (file-name-nondirectory dir)))
                   do (push (file-name-nondirectory dir) results)))
        (aiaos-cli--result-success
         :query query
         :results results
         :count (length results)
         :output (if results
                     (format "Found %d skill(s) matching '%s':\n%s"
                             (length results) query
                             (mapconcat (lambda (r) (format "  - %s" r)) results "\n"))
                   (format "No skills found matching '%s'" query)))))))

