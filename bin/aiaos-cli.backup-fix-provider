#!/usr/bin/env bash
# AIAOS-CLI 主入口脚本
# 版本: 1.0.0

set -euo pipefail

# ============================================================================
# 常量定义
# ============================================================================
readonly AIAOS_CLI_VERSION="1.0.0"
readonly AIAOS_CLI_NAME="aiaos-cli"

# 目录解析
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export AIAOS_CLI_ROOT="$(dirname "$SCRIPT_DIR")"
export AIAOS_CLI_CORE_DIR="$AIAOS_CLI_ROOT/core"
export AIAOS_CLI_SKILLS_DIR="$AIAOS_CLI_ROOT/skills"
export AIAOS_CLI_ELISP_DIR="$AIAOS_CLI_ROOT/elisp"
export AIAOS_CLI_DATA_DIR="${AIAOS_CLI_DATA_DIR:-$HOME/.local/share/aiaos}"
export AIAOS_CLI_CONFIG_DIR="${AIAOS_CLI_CONFIG_DIR:-$HOME/.config/aiaos}"
export AIAOS_CLI_CACHE_DIR="${AIAOS_CLI_CACHE_DIR:-$HOME/.cache/aiaos}"
export AIAOS_CLI_OUTPUT_FORMAT="${AIAOS_CLI_OUTPUT_FORMAT:-table}"

# ============================================================================
# 日志函数
# ============================================================================
# 日志级别比较
_log_level_num() {
    case "$1" in
        debug) echo 0 ;;
        info)  echo 1 ;;
        warn)  echo 2 ;;
        error) echo 3 ;;
        *)     echo 1 ;;
    esac
}

# 核心日志写入函数
_log_write() {
    local level="$1"
    shift
    local message="$*"
    local timestamp=$(date '+%Y-%m-%dT%H:%M:%S')
    local formatted="[$level] [$timestamp] $message"
    
    # 输出到 stderr（控制台保持人类可读文本）
    echo "$formatted" >&2
    
    # 写入文件（JSON Lines 格式，对齐 skills.md §4 约束4）
    # R2105 修复 D1: 原实现写入文本格式，与规范 JSON Lines 漂移
    if [[ -n "${AIAOS_CLI_LOG_FILE:-}" ]]; then
        local config_level_num=$(_log_level_num "${AIAOS_CLI_LOG_LEVEL:-info}")
        local msg_level_num=$(_log_level_num "$level")
        if [[ $msg_level_num -ge $config_level_num ]]; then
            # 构造 JSON 对象，手动转义 message 中的特殊字符
            local msg_escaped=$(printf '%s' "$message" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read(), ensure_ascii=False, separators=(",", ":")))')
            local level_lower=$(printf '%s' "$level" | tr '[:upper:]' '[:lower:]')
            printf '{"level":"%s","timestamp":"%s","message":%s}
' "$level_lower" "$timestamp" "$msg_escaped" >> "$AIAOS_CLI_LOG_FILE"
        fi
    fi
}

log_debug() { [[ "${AIAOS_CLI_DEBUG:-0}" == "1" ]] && _log_write "DEBUG" "$*"; return 0; }
log_info()  { _log_write "INFO"  "$*"; }
log_warn()  { _log_write "WARN"  "$*"; }
log_error() { _log_write "ERROR" "$*"; }

# ============================================================================
# 帮助信息
# ============================================================================
show_help() {
    cat <<EOF
用法: aiaos-cli <域> <动作> [目标] [选项]

域:
  session     会话管理 (new, list, show, switch, archive, delete)
  context     上下文操作 (show, save, load, clear, export)
  skill       技能管理 (install, uninstall, list, update, info, search, validate, run, deps)
  agent       Agent 交互 (chat, delegate, tool, history)
  project     项目操作 (init, sync, build, deploy, status)
  config      配置管理 (get, set, list, edit, validate, migrate)
  doctor      环境诊断 (check, fix, report)
  log         日志查看 (tail, search, export, analyze, list)
  help        显示帮助
  version     显示版本

通用选项:
  -d, --debug         开启调试模式
  -q, --quiet         静默模式
  --format FORMAT     输出格式 (json|table|csv|yaml, 默认: table)
  --config FILE       指定配置文件
  --data-dir DIR      指定数据目录

示例:
  aiaos-cli session new --name my-session
  aiaos-cli skill install git@github.com:user/aiaos-skill-example.git
  aiaos-cli agent chat --message "帮我分析代码"
  aiaos-cli project init --template python

获取子命令帮助:
  aiaos-cli <域> <动作> --help

文档: https://github.com/aiaos/aiaos-cli
EOF
}

show_version() {
    echo "$AIAOS_CLI_NAME v$AIAOS_CLI_VERSION"
}

# ============================================================================
# 环境检查
# ============================================================================
check_environment() {
    local missing=()

    # 检查必要命令
    for cmd in emacs python3 jq; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "缺少必要依赖: ${missing[*]}"
        log_info "请安装: ${missing[*]}"
        return 1
    fi

    # 检查 Emacs 版本
    local emacs_version
    emacs_version=$(emacs --version | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
    if [[ -n "$emacs_version" ]]; then
        local major minor
        major=$(echo "$emacs_version" | cut -d. -f1)
        minor=$(echo "$emacs_version" | cut -d. -f2)
        if [[ $major -lt 28 ]] || [[ $major -eq 28 && $minor -lt 1 ]]; then
            log_warn "Emacs 版本 $emacs_version 可能不兼容，建议 28.1+"
        fi
    fi

    return 0
}

# ============================================================================
# 配置加载
# ============================================================================
load_config() {
    local config_file="${1:-$AIAOS_CLI_CONFIG_DIR/cli.yaml}"
    [[ -z "$config_file" ]] && config_file="$AIAOS_CLI_CONFIG_DIR/cli.yaml"

    if [[ -f "$config_file" ]]; then
        log_debug "加载配置: $config_file"
        export AIAOS_CLI_CONFIG_LOADED=1
    else
        log_debug "配置文件不存在，使用默认配置: $config_file"
    fi
}

# 早期初始化文件日志系统（使用默认值，在配置加载前）
init_file_logging_early() {
    local config_file="${1:-$AIAOS_CLI_CONFIG_DIR/cli.yaml}"
    [[ -z "$config_file" ]] && config_file="$AIAOS_CLI_CONFIG_DIR/cli.yaml"
    
    # 使用默认值
    local log_level="info"
    local log_file="$HOME/.local/share/aiaos/logs/cli.log"
    
    # 如果配置文件存在，尝试读取日志设置
    if [[ -f "$config_file" ]]; then
        log_level=$(python3 -c "
import yaml, os
config_file = os.environ.get('CONFIG_FILE')
try:
    with open(config_file) as f:
        data = yaml.safe_load(f)
    print(data.get('logging', {}).get('level', 'info'))
except:
    print('info')
" CONFIG_FILE="$config_file")
        
        log_file=$(python3 -c "
import yaml, os
config_file = os.environ.get('CONFIG_FILE')
try:
    with open(config_file) as f:
        data = yaml.safe_load(f)
    log_file = data.get('logging', {}).get('file', '')
    log_file = os.path.expanduser(log_file)
    if log_file and not os.path.isabs(log_file):
        data_dir = os.environ.get('AIAOS_CLI_DATA_DIR', os.path.expanduser('~/.local/share/aiaos'))
        log_file = os.path.join(data_dir, 'logs', 'cli.log')
    elif not log_file:
        data_dir = os.environ.get('AIAOS_CLI_DATA_DIR', os.path.expanduser('~/.local/share/aiaos'))
        log_file = os.path.join(data_dir, 'logs', 'cli.log')
    print(log_file)
except:
    data_dir = os.environ.get('AIAOS_CLI_DATA_DIR', os.path.expanduser('~/.local/share/aiaos'))
    print(os.path.join(data_dir, 'logs', 'cli.log'))
" CONFIG_FILE="$config_file")
    else
        # 使用 AIAOS_CLI_DATA_DIR 如果设置了
        data_dir="${AIAOS_CLI_DATA_DIR:-$HOME/.local/share/aiaos}"
        log_file="$data_dir/logs/cli.log"
    fi
    
    export AIAOS_CLI_LOG_LEVEL="${log_level}"
    export AIAOS_CLI_LOG_FILE="${log_file}"
    
    # 确保日志目录存在
    if [[ -n "$log_file" ]]; then
        mkdir -p "$(dirname "$log_file")"
        touch "$log_file"
    fi
}

# 初始化文件日志系统（完整版，读取配置）
init_file_logging() {
    local config_file="${1:-$AIAOS_CLI_CONFIG_DIR/cli.yaml}"
    [[ -z "$config_file" ]] && config_file="$AIAOS_CLI_CONFIG_DIR/cli.yaml"
    
    # 读取配置中的日志设置
    if [[ -f "$config_file" ]]; then
        local log_level=$(python3 -c "
import yaml, os
config_file = os.environ.get('CONFIG_FILE')
try:
    with open(config_file) as f:
        data = yaml.safe_load(f)
    print(data.get('logging', {}).get('level', 'info'))
except:
    print('info')
" CONFIG_FILE="$config_file")
        
        local log_file=$(python3 -c "
import yaml, os
config_file = os.environ.get('CONFIG_FILE')
try:
    with open(config_file) as f:
        data = yaml.safe_load(f)
    log_file = data.get('logging', {}).get('file', '')
    # 展开 ~
    log_file = os.path.expanduser(log_file)
    # 如果是相对路径（不是绝对路径），使用 AIAOS_CLI_DATA_DIR
    if log_file and not os.path.isabs(log_file):
        data_dir = os.environ.get('AIAOS_CLI_DATA_DIR', os.path.expanduser('~/.local/share/aiaos'))
        log_file = os.path.join(data_dir, 'logs', 'cli.log')
    elif not log_file:
        data_dir = os.environ.get('AIAOS_CLI_DATA_DIR', os.path.expanduser('~/.local/share/aiaos'))
        log_file = os.path.join(data_dir, 'logs', 'cli.log')
    print(log_file)
except:
    data_dir = os.environ.get('AIAOS_CLI_DATA_DIR', os.path.expanduser('~/.local/share/aiaos'))
    print(os.path.join(data_dir, 'logs', 'cli.log'))
" CONFIG_FILE="$config_file")
    else
        local log_level="info"
        local log_file="$HOME/.local/share/aiaos/logs/cli.log"
    fi
    
    export AIAOS_CLI_LOG_LEVEL="${log_level}"
    export AIAOS_CLI_LOG_FILE="${log_file}"
    
    # 确保日志目录存在
    if [[ -n "$log_file" ]]; then
        mkdir -p "$(dirname "$log_file")"
        # 创建日志文件（如果不存在）
        touch "$log_file"
    fi
}

# ============================================================================
# 命令分发
# ============================================================================
dispatch_command() {
    local domain="$1"
    local action="$2"
    shift 2

    # Export log functions so core modules can use them
    export -f _log_write _log_level_num log_debug log_info log_warn log_error
    
    case "$domain" in
        session)
            source "$AIAOS_CLI_CORE_DIR/session.sh" "$action" "$@"
            ;;
        context)
            source "$AIAOS_CLI_CORE_DIR/context.sh" "$action" "$@"
            ;;
        skill)
            source "$AIAOS_CLI_CORE_DIR/skill.sh" "$action" "$@"
            ;;
        agent)
            source "$AIAOS_CLI_CORE_DIR/agent.sh" "$action" "$@"
            ;;
        project)
            source "$AIAOS_CLI_CORE_DIR/project.sh" "$action" "$@"
            ;;
        config)
            source "$AIAOS_CLI_CORE_DIR/config.sh" "$action" "$@"
            ;;
        doctor)
            source "$AIAOS_CLI_CORE_DIR/doctor.sh" "$action" "$@"
            ;;
        log)
            source "$AIAOS_CLI_CORE_DIR/log.sh" "$action" "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        *)
            log_error "未知域: $domain"
            show_help
            exit 1
            ;;
    esac
}

# ============================================================================
# 主入口
# ============================================================================
main() {
    local debug=0 quiet=0 format="table" config_file="" data_dir=""
    local args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--debug)
                debug=1
                export AIAOS_CLI_DEBUG=1
                shift
                ;;
            -q|--quiet)
                quiet=1
                shift
                ;;
            --format)
                format="$2"
                export AIAOS_CLI_OUTPUT_FORMAT="$format"
                shift 2
                ;;
            --format=*)
                format="${1#*=}"
                export AIAOS_CLI_OUTPUT_FORMAT="$format"
                shift
                ;;
            --config)
                config_file="$2"
                shift 2
                ;;
            --data-dir)
                data_dir="$2"
                export AIAOS_CLI_DATA_DIR="$data_dir"
                shift 2
                ;;
            -h|--help)
                # R1230: 仅当未收集到任何域参数时才拦截 --help，
                # 否则透传给子命令，支持 `aiaos-cli skill list --help` 等子命令级帮助。
                if [[ ${#args[@]} -eq 0 ]]; then
                    show_help
                    exit 0
                else
                    args+=("$1")
                    shift
                fi
                ;;
            -v|--version)
                if [[ ${#args[@]} -eq 0 ]]; then
                    show_version
                    exit 0
                else
                    args+=("$1")
                    shift
                fi
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done

    if [[ $debug -eq 1 ]]; then
        export AIAOS_CLI_LOG_LEVEL="debug"
    elif [[ $quiet -eq 1 ]]; then
        export AIAOS_CLI_LOG_LEVEL="error"
    fi

    # Initialize file logging EARLY with defaults, before any log messages
    # This ensures all log messages are captured
    init_file_logging_early "$config_file"
    
    load_config "$config_file"
    
    # Ensure config exists before initializing file logging
    # This is needed because config domains (like config list) create the config file
    if [[ "${args[0]:-}" == "config" ]] || [[ ! -f "$config_file" ]]; then
        # Source config.sh to get ensure_config function
        source "$AIAOS_CLI_CORE_DIR/config.sh" "help" >/dev/null 2>&1 || true
        ensure_config
    fi
    
    # Re-initialize with actual config values
    init_file_logging "$config_file"

    if [[ ${#args[@]} -gt 0 ]]; then
        check_environment || exit 1
    fi

    if [[ ${#args[@]} -eq 0 ]]; then
        show_help
        exit 0
    fi

    local domain="${args[0]}"
    local action="${args[1]:-help}"

    dispatch_command "$domain" "$action" "${args[@]:2}"
}

main "$@"