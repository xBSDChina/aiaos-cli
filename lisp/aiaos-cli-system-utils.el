(require 'cl-lib)

(defun aiaos-cli-system--format-bytes (bytes)
  "将字节数格式化为人类可读的格式"
  (cond
   ((< bytes 1024) (format "%d B" bytes))
   ((< bytes 1048576) (format "%.2f KB" (/ bytes 1024.0)))
   ((< bytes 1073741824) (format "%.2f MB" (/ bytes 1048576.0)))
   ((< bytes 1099511627776) (format "%.2f GB" (/ bytes 1073741824.0)))
   (t (format "%.2f TB" (/ bytes 1099511627776.0)))))

(defun aiaos-cli-system--get-cpu-info (interval)
  "获取CPU信息，返回alist"
  (let ((cpu-model "未知")
        (cores 0)
        (threads 0)
        (usage 0.0)
        (user-pct 0.0)
        (sys-pct 0.0)
        (idle-pct 0.0)
        (load1 0.0)
        (load5 0.0)
        (load15 0.0))
    
    ;; 获取CPU型号
    (when (file-exists-p "/proc/cpuinfo")
      (let ((cpuinfo (shell-command-to-string "cat /proc/cpuinfo")))
        (when (string-match "^model name[[:space:]]*:[[:space:]]*\\(.*\\)" cpuinfo)
          (setq cpu-model (match-string 1 cpuinfo)))))
    
    ;; 获取核心数和线程数
    (when (file-exists-p "/proc/cpuinfo")
      (let ((cpuinfo (shell-command-to-string "cat /proc/cpuinfo")))
        (with-temp-buffer
          (insert cpuinfo)
          (goto-char (point-min))
          (let ((count 0))
            (while (re-search-forward "^processor[[:space:]]*:[[:space:]]*[0-9]+" nil t)
              (cl-incf count))
            (setq cores count)
            (setq threads count)))))
    
    ;; 获取负载信息
    (when (file-exists-p "/proc/loadavg")
      (let ((loadavg (shell-command-to-string "cat /proc/loadavg")))
        (let ((loads (split-string loadavg)))
          (when (> (length loads) 0)
            (setq load1 (string-to-number (nth 0 loads))))
          (when (> (length loads) 1)
            (setq load5 (string-to-number (nth 1 loads))))
          (when (> (length loads) 2)
            (setq load15 (string-to-number (nth 2 loads)))))))
    
    ;; 获取CPU使用率（从/proc/stat读取两次）
    (let ((stat1 (shell-command-to-string "cat /proc/stat | head -1"))
          (stat2 ""))
      (when (> interval 0)
        (sleep-for interval))
      (setq stat2 (shell-command-to-string "cat /proc/stat | head -1"))
      
      (let ((fields1 (split-string stat1))
            (fields2 (split-string stat2)))
        (when (and fields1 fields2)
          (let* ((idle1 (string-to-number (nth 4 fields1)))
                 (total1 (apply '+ (mapcar 'string-to-number (cdr fields1))))
                 (idle2 (string-to-number (nth 4 fields2)))
                 (total2 (apply '+ (mapcar 'string-to-number (cdr fields2))))
                 (idle-diff (- idle2 idle1))
                 (total-diff (- total2 total1)))
            (when (> total-diff 0)
              (setq idle-pct (* 100.0 idle-diff total-diff))
              (setq usage (- 100.0 idle-pct))
              (setq user-pct (/ (- (string-to-number (nth 1 fields2)) 
                                  (string-to-number (nth 1 fields1))) total-diff 100.0))
              (setq sys-pct (/ (- (string-to-number (nth 2 fields2)) 
                                 (string-to-number (nth 2 fields1))) total-diff 100.0)))))))
    
    ;; 返回结果
    `((model . ,cpu-model)
      (cores . ,cores)
      (threads . ,threads)
      (usage . ,usage)
      (user_pct . ,user-pct)
      (sys_pct . ,sys-pct)
      (idle_pct . ,idle-pct)
      (load1 . ,load1)
      (load5 . ,load5)
      (load15 . ,load15))))

(defun aiaos-cli-system--get-memory-info ()
  "获取内存信息，返回alist"
  (let ((total 0)
        (used 0)
        (available 0)
        (buffers 0)
        (cached 0)
        (swap-total 0)
        (swap-used 0)
        (swap-available 0))
    
    ;; 从/proc/meminfo读取内存信息
    (when (file-exists-p "/proc/meminfo")
      (let ((meminfo (shell-command-to-string "cat /proc/meminfo")))
        (when (string-match "MemTotal:[[:space:]]*\\([0-9]+\\)" meminfo)
          (setq total (* (string-to-number (match-string 1 meminfo)) 1024)))
        (when (string-match "MemAvailable:[[:space:]]*\\([0-9]+\\)" meminfo)
          (setq available (* (string-to-number (match-string 1 meminfo)) 1024)))
        (when (string-match "Buffers:[[:space:]]*\\([0-9]+\\)" meminfo)
          (setq buffers (* (string-to-number (match-string 1 meminfo)) 1024)))
        (when (string-match "Cached:[[:space:]]*\\([0-9]+\\)" meminfo)
          (setq cached (* (string-to-number (match-string 1 meminfo)) 1024)))
        (when (string-match "SwapTotal:[[:space:]]*\\([0-9]+\\)" meminfo)
          (setq swap-total (* (string-to-number (match-string 1 meminfo)) 1024)))
        (when (string-match "SwapFree:[[:space:]]*\\([0-9]+\\)" meminfo)
          (setq swap-available (* (string-to-number (match-string 1 meminfo)) 1024)))))
    
    (setq used (- total available))
    (setq swap-used (- swap-total swap-available))
    
    `((total . ,total)
      (used . ,used)
      (available . ,available)
      (buffers . ,buffers)
      (cached . ,cached)
      (swap_total . ,swap-total)
      (swap_used . ,swap-used)
      (swap_available . ,swap-available))))

(defun aiaos-cli-system--get-disk-info (mount-filter)
  "获取磁盘信息，返回alist"
  (let ((partitions '()))
    
    ;; 使用df命令获取磁盘信息
    (let ((df-output (shell-command-to-string "df -hP 2>/dev/null")))
      (let ((lines (split-string df-output "\n")))
        (dolist (line lines)
          (when (and line (not (string-prefix-p "Filesystem" line))
                     (not (string-match "^$" line)))
            (let ((fields (split-string line)))
              (when (>= (length fields) 6)
                (let ((device (nth 0 fields))
                      (size (nth 1 fields))
                      (used (nth 2 fields))
                      (available (nth 3 fields))
                      (use-pct (nth 4 fields))
                      (mountpoint (nth 5 fields)))
                  (when (or (string= mount-filter "")
                           (string= mountpoint mount-filter))
                    (push `((device . ,device)
                            (mountpoint . ,mountpoint)
                            (fstype . "unknown")
                            (size . ,(aiaos-cli-system--parse-size size))
                            (used . ,(aiaos-cli-system--parse-size used))
                            (available . ,(aiaos-cli-system--parse-size available))
                            (use_pct . ,(string-to-number use-pct)))
                          partitions)))))))
    
    `((partitions . ,partitions))))))

(defun aiaos-cli-system--parse-size (size-str)
  "解析大小字符串，返回字节数"
  (let ((size 0))
    (cond
     ((string-match "\\([0-9.]+\\)[[:space:]]*TB" size-str)
      (setq size (* (string-to-number (match-string 1 size-str)) 1099511627776)))
     ((string-match "\\([0-9.]+\\)[[:space:]]*GB" size-str)
      (setq size (* (string-to-number (match-string 1 size-str)) 1073741824)))
     ((string-match "\\([0-9.]+\\)[[:space:]]*MB" size-str)
      (setq size (* (string-to-number (match-string 1 size-str)) 1048576)))
     ((string-match "\\([0-9.]+\\)[[:space:]]*KB" size-str)
      (setq size (* (string-to-number (match-string 1 size-str)) 1024)))
     ((string-match "\\([0-9.]+\\)[[:space:]]*B" size-str)
      (setq size (string-to-number (match-string 1 size-str)))))
    size))

(defun aiaos-cli-system--get-os-info (detail)
  "获取操作系统信息，返回alist"
  (let ((system "Linux")
        (name "未知")
        (version "未知")
        (distro "未知")
        (kernel "未知")
        (kernel-version "未知")
        (hostname "未知")
        (architecture "未知")
        (processor "未知")
        (uptime nil)
        (users nil)
        (boot-time nil))
    
    ;; 获取系统信息
    (when (file-exists-p "/etc/os-release")
      (let ((os-release (shell-command-to-string "cat /etc/os-release")))
        (when (string-match "NAME=\"\\([^\"]+\\)\"" os-release)
          (setq name (match-string 1 os-release)))
        (when (string-match "VERSION=\"\\([^\"]+\\)\"" os-release)
          (setq version (match-string 1 os-release)))
        (when (string-match "ID_LIKE=\"\\([^\"]+\\)\"" os-release)
          (setq distro (match-string 1 os-release)))))
    
    ;; 获取内核信息
    (when (file-exists-p "/proc/version")
      (let ((version-info (shell-command-to-string "cat /proc/version")))
        (when (string-match "Linux version \\([^ ]+\\)" version-info)
          (setq kernel-version (match-string 1 version-info)))))
    
    ;; 获取主机名
    (when (file-exists-p "/etc/hostname")
      (let ((hostname-file (shell-command-to-string "cat /etc/hostname")))
        (setq hostname (string-trim hostname-file))))
    
    ;; 获取架构
    (setq architecture (shell-command-to-string "uname -m"))
    
    ;; 获取处理器信息
    (when (file-exists-p "/proc/cpuinfo")
      (let ((cpuinfo (shell-command-to-string "cat /proc/cpuinfo")))
        (when (string-match "^model name[[:space:]]*:[[:space:]]*\\(.*\\)" cpuinfo)
          (setq processor (match-string 1 cpuinfo)))))
    
    ;; 详细信息
    (when detail
      (setq uptime (shell-command-to-string "uptime -p 2>/dev/null || uptime"))
      (setq users (shell-command-to-string "who | wc -l"))
      (setq boot-time (shell-command-to-string "uptime -s 2>/dev/null || who -b")))
    
    `((system . ,system)
      (name . ,name)
      (version . ,version)
      (distro . ,distro)
      (kernel . ,kernel)
      (kernel-version . ,kernel-version)
      (hostname . ,hostname)
      (architecture . ,architecture)
      (processor . ,processor)
      (uptime . ,uptime)
      (users . ,users)
      (boot-time . ,boot-time))))


(defun aiaos-cli-system--get-load-info (&optional detail)
  "获取系统负载详细信息，返回alist。"
  (let* ((load-line (shell-command-to-string "cat /proc/loadavg 2>/dev/null"))
         (load-fields (split-string load-line))
         (load1 (if (> (length load-fields) 0) (string-to-number (nth 0 load-fields)) 0.0))
         (load5 (if (> (length load-fields) 1) (string-to-number (nth 1 load-fields)) 0.0))
         (load15 (if (> (length load-fields) 2) (string-to-number (nth 2 load-fields)) 0.0))
         (procs-part (if (> (length load-fields) 3) (nth 3 load-fields) "0/0"))
         (proc-fields (split-string procs-part "/"))
         (running (if (> (length proc-fields) 0) (nth 0 proc-fields) "0"))
         (total-procs (if (> (length proc-fields) 1) (nth 1 proc-fields) "0"))
         (stat-line (shell-command-to-string "head -2 /proc/stat 2>/dev/null"))
         (stat-lines (split-string stat-line "\n"))
         (stat-fields (if (> (length stat-lines) 0) (split-string (nth 0 stat-lines)) nil))
         (ctxt (or (cadr (member "ctxt" stat-fields)) "0"))
         (intr (or (cadr (member "intr" stat-fields)) "0"))
         (cpuinfo (shell-command-to-string "cat /proc/cpuinfo 2>/dev/null"))
         (let ((cpu-count 0))
         (with-temp-buffer
           (insert cpuinfo)
           (goto-char (point-min))
           (while (re-search-forward "^processor[[:space:]]*:[[:space:]]*[0-9]+" nil t)
             (cl-incf cpu-count))
           (setq cores cpu-count)))
         (zombies-line (shell-command-to-string "ps -eo stat 2>/dev/null | awk \'/^Z/{n++} END{print n+0}\'"))
         (zombies (replace-regexp-in-string zombies-line "\s-+" "")))
    (when (= cores 0)
      (setq cores (length (split-string (shell-command-to-string "nproc 2>/dev/null || echo 1") "\s-+"))))
    `((load1 . ,load1)
      (load5 . ,load5)
      (load15 . ,load15)
      (running . ,running)
      (total_procs . ,total-procs)
      (ctxt . ,ctxt)
      (intr . ,intr)
      (zombies . ,zombies)
      (cores . ,cores)
      ,@(when detail '((source . "/proc/loadavg,/proc/stat,/proc/cpuinfo"))))))

(provide 'aiaos-cli-system-utils)
