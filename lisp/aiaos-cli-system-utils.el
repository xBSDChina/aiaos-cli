(defun aiaos-cli-system--get-net-info (&optional detail)
  "获取网络接口与 TCP 连接信息，返回 alist。"
  (let* ((dev-lines (split-string (shell-command-to-string "cat /proc/net/dev 2>/dev/null") "\n"))
         (interfaces '())
         (total-rx-bytes 0)
         (total-rx-packets 0)
         (total-rx-errors 0)
         (total-rx-dropped 0)
         (total-tx-bytes 0)
         (total-tx-packets 0)
         (total-tx-errors 0)
         (total-tx-dropped 0))
    ;; 解析 /proc/net/dev (跳过前两行表头)
    (dolist (line (cl-subseq dev-lines 2))
      (let* ((fields (split-string line))
             (iface (replace-regexp-in-string ":" "" (nth 0 fields)))
             (rx-bytes (string-to-number (nth 1 fields)))
             (rx-packets (string-to-number (nth 2 fields)))
             (rx-errors (string-to-number (nth 3 fields)))
             (rx-dropped (string-to-number (nth 4 fields)))
             (tx-bytes (string-to-number (nth 9 fields)))
             (tx-packets (string-to-number (nth 10 fields)))
             (tx-errors (string-to-number (nth 11 fields)))
             (tx-dropped (string-to-number (nth 12 fields))))
        (when (and iface (not (string= iface "lo")))
          (push `((name . ,iface)
                  (rx_bytes . ,rx-bytes)
                  (rx_packets . ,rx-packets)
                  (rx_errors . ,rx-errors)
                  (rx_dropped . ,rx-dropped)
                  (tx_bytes . ,tx-bytes)
                  (tx_packets . ,tx-packets)
                  (tx_errors . ,tx-errors)
                  (tx_dropped . ,tx-dropped))
                interfaces)
          (setq total-rx-bytes (+ total-rx-bytes rx-bytes))
          (setq total-rx-packets (+ total-rx-packets rx-packets))
          (setq total-rx-errors (+ total-rx-errors rx-errors))
          (setq total-rx-dropped (+ total-rx-dropped rx-dropped))
          (setq total-tx-bytes (+ total-tx-bytes tx-bytes))
          (setq total-tx-packets (+ total-tx-packets tx-packets))
          (setq total-tx-errors (+ total-tx-errors tx-errors))
          (setq total-tx-dropped (+ total-tx-dropped tx-dropped)))))
    ;; TCP 连接数
    (let* ((tcp4 (shell-command-to-string "cat /proc/net/tcp 2>/dev/null | wc -l"))
           (tcp6 (shell-command-to-string "cat /proc/net/tcp6 2>/dev/null | wc -l"))
           (tcp4-count (max 0 (- (string-to-number tcp4) 1)))
           (tcp6-count (max 0 (- (string-to-number tcp6) 1))))
      `((iface_count . ,(length interfaces))
        (interfaces . ,(nreverse interfaces))
        (total_rx_bytes . ,total-rx-bytes)
        (total_rx_packets . ,total-rx-packets)
        (total_rx_errors . ,total-rx-errors)
        (total_rx_dropped . ,total-rx-dropped)
        (total_tx_bytes . ,total-tx-bytes)
        (total_tx_packets . ,total-tx-packets)
        (total_tx_errors . ,total-tx-errors)
        (total_tx_dropped . ,total-tx-dropped)
        (tcp_connections . ,(+ tcp4-count tcp6-count))
        (tcp4_connections . ,tcp4-count)
        (tcp6_connections . ,tcp6-count)
        ,@(when detail '((source . "/proc/net/dev,/proc/net/tcp,/proc/net/tcp6")))))))

(provide 'aiaos-cli-system-utils)
