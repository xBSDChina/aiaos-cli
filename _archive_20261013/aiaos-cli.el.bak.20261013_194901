;; ─── HTTP Client ─────────────────────────────────────────────────────────────

(defun aiaos-cli--http-post (url api-key body-json timeout)
  "Send HTTP POST request to URL with API-KEY and BODY-JSON.
Timeout is TIMEOUT seconds. This is the probe window for the LLM provider.
Return response body string, or signal aiaos-cli-llm-timeout if timeout exceeded."
  (let ((req-file (make-temp-file "aiaos-cli-req-"))
        (resp-file (make-temp-file "aiaos-cli-resp-"))
        (proc-buf (get-buffer-create (generate-new-buffer-name "*aiaos-http*")))
        (proc-name (generate-new-buffer-name "aiaos-http"))
        (deadline (time-add (current-time) (seconds-to-time timeout))))
    (with-current-buffer (find-file-noselect req-file)
      (insert body-json)
      (write-region (point-min) (point-max) req-file))
    (let ((proc (start-process
                  proc-name proc-buf
                  "curl" "-s" "-X" "POST"
                  "--max-time" (number-to-string timeout)
                  "-H" (format "Authorization: Bearer %s" api-key)
                  "-H" "Content-Type: application/json"
                  "--data-binary" (format "@%s" req-file)
                  "-o" resp-file
                  "-w" "%{http_code}"
                  url)))
      (unless (process-live-p proc)
        (signal 'aiaos-cli-llm-error (list "Failed to start curl" url "0")))
      ;; Wait up to timeout seconds for the process to complete
      (while (and (process-live-p proc)
                  (time-less-p (current-time) deadline))
        (accept-process-output (list proc) 1))
      (when (process-live-p proc)
        (kill-process proc)
        (signal 'aiaos-cli-llm-timeout (list "Request timed out" url (number-to-string timeout))))
      (when (= (process-exit-status proc) 0)
        (with-current-buffer (find-file-noselect resp-file)
          (buffer-string)))
      (delete-file req-file)
      (delete-file resp-file))))

(defun aiaos-cli--http-post-stream (url api-key body-json timeout callback)
  "Send HTTP POST with SSE streaming. CALLBACK called with each SSE data line.
Timeout is TIMEOUT seconds. This is the probe window for the LLM provider."
  (let ((req-file (make-temp-file "aiaos-cli-req-"))
        (proc-buf (get-buffer-create (generate-new-buffer-name "*aiaos-stream*")))
        (proc-name (generate-new-buffer-name "aiaos-stream"))
        (deadline (time-add (current-time) (seconds-to-time timeout))))
    (with-current-buffer (find-file-noselect req-file)
      (insert body-json)
      (write-region (point-min) (point-max) req-file))
    (let ((proc (start-process
                  proc-name proc-buf
                  "curl" "-s" "-X" "POST"
                  "--max-time" (number-to-string timeout)
                  "-H" (format "Authorization: Bearer %s" api-key)
                  "-H" "Content-Type: application/json"
                  "-H" "Accept: text/event-stream"
                  "--data-binary" (format "@%s" req-file)
                  url)))
      (unless (process-live-p proc)
        (signal 'aiaos-cli-llm-error (list "Failed to start curl" url "0")))
      ;; Wait up to timeout seconds, processing SSE events as they arrive
      (while (and (process-live-p proc)
                  (time-less-p (current-time) deadline))
        (accept-process-output (list proc) 1)
        (when (buffer-size proc-buf)
          (let ((data (with-current-buffer proc-buf
                         (buffer-string))))
            (with-current-buffer proc-buf
              (delete-region (point-min) (point-max)))
            (dolist (line (split-string data "\n"))
              (when (string-prefix-p "data:" line)
                (let ((payload (aiaos-cli--trim (substring line 5))))
                  (when (and (not (string-empty-p payload))
                             (not (string= payload "[DONE]")))
                    (funcall callback payload)))))))
      (when (process-live-p proc)
        (kill-process proc)
        (signal 'aiaos-cli-llm-timeout (list "Stream timed out" url (number-to-string timeout))))
      (delete-file req-file)))))

;; ─── Provider Management ─────────────────────────────────────────────────────

(defun aiaos-cli--load-providers ()
  "Load providers from configuration file."
  (if (file-exists-p aiaos-cli-providers-file)
      (let ((config (aiaos-cli--json-file-to-elisp aiaos-cli-providers-file)))
        (setq aiaos-cli--providers config)
        (setq aiaos-cli--provider-order (gethash :order config))
        (if (null aiaos-cli--provider-order)
            (setq aiaos-cli--provider-order (hash-table-keys config))
          (setq aiaos-cli--provider-order
                (mapcar (lambda (k)
                           (if (stringp k) k (symbol-name k)))
                         aiaos-cli--provider-order)))
        (message "[AIAOS] Loaded %d providers, default: %s"
                 (length aiaos-cli--provider-order)
                 aiaos-cli-default-provider))
    (message "[AIAOS] Warning: providers file not found at %s" aiaos-cli-providers-file)
    (setq aiaos-cli--providers '())
    (setq aiaos-cli--provider-order '()))
  t)

(defun aiaos-cli--get-provider-config (provider-name)
  "Get configuration for PROVIDER-NAME."
  (gethash provider-name aiaos-cli--providers))

(defun aiaos-cli--get-current-provider ()
  "Get current provider name."
  (nth aiaos-cli--current-provider-index aiaos-cli--provider-order))

(defun aiaos-cli--resolve-provider-target (provider-name)
  "Return (name endpoint model) for PROVIDER-NAME."
  (let* ((cfg (aiaos-cli--get-provider-config provider-name))
         (api-url (gethash :api-url cfg))
         (model (gethash :default-model cfg)))
    (list provider-name api-url model)))

(defun aiaos-cli--advance-provider ()
  "Advance to next provider in the list."
  (setq aiaos-cli--current-provider-index
        (mod (1+ aiaos-cli--current-provider-index)
             (length aiaos-cli--provider-order))))

(defun aiaos-cli--record-provider-stat (provider-name success error-msg)
  "Record provider statistics."
  (let ((stat (assoc provider-name aiaos-cli--provider-stats)))
    (if stat
        (setcdr stat (list (1+ (nth 0 (cdr stat)))
                           (1+ (nth 1 (cdr stat)))
                           (nth 2 (cdr stat))
                           (nth 3 (cdr stat))))
      (push (list provider-name 0 0 nil nil) aiaos-cli--provider-stats))
    (when success
      (let ((stat (assoc provider-name aiaos-cli--provider-stats)))
        (setf (nth 2 (cdr stat)) t))
    (when error-msg
      (let ((stat (assoc provider-name aiaos-cli--provider-stats)))
        (setf (nth 3 (cdr stat)) error-msg))))))

;; ─── Request Building ────────────────────────────────────────────────────────

(defun aiaos-cli--build-request-body (provider-name)
  "Build request body for PROVIDER-NAME."
  (let* ((target (aiaos-cli--resolve-provider-target provider-name))
         (model (nth 2 target))
         (messages (list (cons "system" aiaos-cli-system-prompt)
                         (apply #'append (mapcar (lambda (m)
                                                   (list (cons (car m) (cdr m))))
                                                 (reverse aiaos-cli--conversation))))))
    (list :model model
          :messages messages
          :stream aiaos-cli-enable-streaming
          :tools (aiaos-cli--get-tools))))

(defun aiaos-cli--get-tools ()
  "Get available tools for LLM."
  (list
   (list :type "function"
         :function (list :name "read_file"
                         :description "Read contents of a file"
                         :parameters (list :type "object"
                                           :properties (list :path (list :type "string" :description "File path"))
                                           :required (list "path"))))
   (list :type "function"
         :function (list :name "write_file"
                         :description "Write content to a file"
                         :parameters (list :type "object"
                                           :properties (list :path (list :type "string" :description "File path")
                                                             :content (list :type "string" :description "File content"))
                                           :required (list "path" "content"))))
   (list :type "function"
         :function (list :name "list_files"
                         :description "List files in a directory"
                         :parameters (list :type "object"
                                           :properties (list :path (list :type "string" :description "Directory path"))
                                           :required (list "path"))))))

;; ─── Response Parsing ────────────────────────────────────────────────────────

(defun aiaos-cli--extract-content (data)
  "Extract content and tool_calls from parsed LLM response DATA."
  (let ((choices (plist-get data :choices)))
    (if (null choices)
        (signal 'aiaos-cli-llm-error (list "No choices in response" "unknown" "unknown"))
      (let ((message (plist-get (first choices) :message)))
        (list (plist-get message :content)
              (plist-get message :tool_calls))))))

(defun aiaos-cli--parse-sse-line (line)
  "Parse SSE line and return data payload or nil."
  (if (string-prefix-p "data:" line)
      (aiaos-cli--trim (substring line 5))
    nil))

(defun aiaos-cli--extract-stream-chunk (data)
  "Extract content delta, tool_calls, and finish_reason from stream chunk DATA."
  (let ((parsed (aiaos-cli--json-string-to-elisp data)))
    (let ((choices (plist-get parsed :choices)))
      (when (and choices (first choices))
        (let ((delta (plist-get (first choices) :delta)))
          (list (plist-get delta :content)
                (plist-get delta :tool_calls)
                (plist-get (first choices) :finish_reason)))))))

;; ─── Tool Execution ──────────────────────────────────────────────────────────

(defun aiaos-cli--tool-allowed (name)
  "Check if tool NAME is allowed."
  (or (null aiaos-cli-tool-allowlist)
      (member name aiaos-cli-tool-allowlist)))

(defun aiaos-cli--execute-tool (name arguments-json)
  "Execute tool NAME with ARGUMENTS-JSON. Return result string."
  (unless (aiaos-cli--tool-allowed name)
    (error (format "Tool '%s' not in allowlist" name)))
  (condition-case e
      (let ((args (aiaos-cli--json-string-to-elisp arguments-json)))
        (cond
         ((string= name "read_file")
          (let ((path (gethash "path" args)))
            (if (not path)
                (error "read_file: missing path")
              (if (file-exists-p path)
                  (with-current-buffer (find-file-noselect path)
                    (buffer-string))
                (error (format "File not found: %s" path))))))
         ((string= name "write_file")
          (let ((path (gethash "path" args))
                (content (gethash "content" args)))
            (if (or (not path) (not content))
                (error "write_file: missing path or content")
              (with-current-buffer (find-file-noselect path)
                (delete-region (point-min) (point-max))
                (insert content)
                (write-region (point-min) (point-max) path))
              (format "Written %d bytes to %s" (length content) path))))
         ((string= name "list_files")
          (let ((path (gethash "path" args)))
            (if (not path)
                (error "list_files: missing path")
              (if (file-directory-p path)
                  (mapconcat (lambda (f)
                               (format "%8d %s"
                                       (nth 7 (file-attributes f))
                                       f))
                             (directory-files path t)
                             "\n")
                (error (format "Not a directory: %s" path))))))
         (t (format "ERROR: Unknown tool '%s'" name))))
    (error (format "TOOL ERROR [%s]: %s" name (error-message-string e)))))

;; ─── LLM Interaction ─────────────────────────────────────────────────────────

(defun aiaos-cli--try-provider (provider-name retry)
  "Try LLM request with PROVIDER-NAME. RETRY is the retry count for logging.
Each attempt waits up to aiaos-cli-timeout (30s) for response.
Signals aiaos-cli-llm-error or aiaos-cli-llm-timeout on failure."
  (let* ((target (aiaos-cli--resolve-provider-target provider-name))
         (prov-name (nth 0 target))
         (api-url (nth 1 target))
         (model (nth 2 target))
         (cfg (aiaos-cli--get-provider-config prov-name))
         (api-key (plist-get cfg :api-key))
         (body (aiaos-cli--build-request-body prov-name))
         (body-json (json-encode body))
         response-content tool-calls steps)
    (unless api-key
      (signal 'aiaos-cli-llm-auth (list "No API key configured" prov-name "401")))
    (unless api-url
      (signal 'aiaos-cli-llm-error (list "No API URL configured" prov-name "0")))
    (setq steps 0)
    (while (< steps aiaos-cli-max-agent-steps)
      (if aiaos-cli-enable-streaming
          (aiaos-cli--http-post-stream
           api-url api-key body-json aiaos-cli-timeout
           (lambda (line)
             (let ((data (aiaos-cli--parse-sse-line line)))
               (when data
                 (let ((chunk (aiaos-cli--extract-stream-chunk data)))
                   (when chunk
                     (let ((cd (nth 0 chunk))
                           (tc (nth 1 chunk))
                           (fr (nth 2 chunk)))
                       (when cd (setq response-content (concat response-content cd)))
                       (when tc (setq tool-calls (append (or tool-calls '()) tc)))
                       (when fr (ignore fr)))))))))
        (let ((raw (aiaos-cli--http-post api-url api-key body-json aiaos-cli-timeout)))
          (let ((data (aiaos-cli--json-string-to-elisp raw)))
            (let ((parsed (aiaos-cli--extract-content data)))
              (setq response-content (nth 0 parsed))
              (setq tool-calls (nth 1 parsed))))))
      (when tool-calls
        (push (cons "assistant" (list :tool-calls tool-calls
                                      :content response-content))
              aiaos-cli--conversation)
        (dolist (tc tool-calls)
          (when (hash-table-p tc)
            (let* ((id (gethash "id" tc))
                   (fn (gethash "function" tc))
                   (fn-name (when (hash-table-p fn) (gethash "name" fn)))
                   (fn-args (when (hash-table-p fn) (gethash "arguments" fn)))
                   (result nil))
              (message "[AIAOS] Tool: %s" fn-name)
              (condition-case _
                  (setq result (aiaos-cli--execute-tool fn-name fn-args))
                (error (setq result (format "ERROR: %s" (error-message-string it)))))
              (push (cons "tool" (list :tool-call-id id
                                       :content (or result "")))
                    aiaos-cli--conversation))))
        (setq response-content "")
        (setq tool-calls nil)
        (setq body (aiaos-cli--build-request-body prov-name))
        (setq body-json (json-encode body)))
      (setq steps (1+ steps)))
    (if (string-empty-p response-content)
        (signal 'aiaos-cli-llm-error
                (list "Empty response" prov-name "200"))
      response-content)))

(defun aiaos-cli--llm-chat (user-input)
  "Send USER-INPUT to LLM with provider fallback.

DESIGN:
- Each provider attempt waits up to aiaos-cli-timeout (30s) for response
- This timeout IS the probe window - no additional waits are needed
- Only switch to next provider on timeout or error
- Retry up to aiaos-cli-max-retry times per provider before switching

FLOW:
1. For each provider in order:
   a. For retry 0 to max-retry:
      - Send request, wait up to 30s for response
      - If success: return response
      - If timeout/error: log and retry (or switch provider if max retries reached)
2. If all providers fail: signal error"
  (push (cons "user" user-input) aiaos-cli--conversation)
  (let ((total-providers (length aiaos-cli--provider-order))
        (prov-attempt 0)
        (last-err nil))
    (while (< prov-attempt total-providers)
      (let ((prov-name (aiaos-cli--get-current-provider))
            (retry 0)
            response)
        (while (<= retry aiaos-cli-max-retry)
          (message "[AIAOS] Provider: %s (retry %d/%d)" prov-name retry aiaos-cli-max-retry)
          (condition-case err
              (progn
                (setq response (aiaos-cli--try-provider prov-name retry))
                (aiaos-cli--record-provider-stat prov-name t nil)
                (throw 'aiaos-cli--llm-chat-done response))
            (aiaos-cli-llm-error
             (setq last-err (error-message-string err))
             (aiaos-cli--record-provider-stat prov-name nil last-err)
             (push (list prov-name last-err (current-time-string))
                   aiaos-cli--error-log)
             (message "[AIAOS] Provider %s failed: %s" prov-name last-err)
             (if (< retry aiaos-cli-max-retry)
                 (setq retry (1+ retry))
               (progn
                 (aiaos-cli--advance-provider)
                 (setq prov-attempt (1+ prov-attempt)))))))))
    (signal 'aiaos-cli-llm-error
            (list (or last-err "All providers failed") "unknown" "0"))))

;; ─── Debug Probe ─────────────────────────────────────────────────────────────

(defun aiaos-cli--debug-probe ()
  "Debug: probe all providers with 30s timeout each.
Each provider gets one attempt with the full timeout window."
  (interactive)
  (message "[AIAOS] Starting debug probe with %ds timeout per provider..." aiaos-cli-timeout)
  (let ((i 0))
    (while (< i (length aiaos-cli--provider-order))
      (let ((prov-name (nth i aiaos-cli--provider-order))
            (target (aiaos-cli--resolve-provider-target (nth i aiaos-cli--provider-order))))
        (message "[AIAOS] Probing %s (%s)..." prov-name (nth 1 target))
        (condition-case err
            (progn
              (aiaos-cli--try-provider prov-name 0)
              (message "[AIAOS] %s: SUCCESS" prov-name))
          (aiaos-cli-llm-error
           (message "[AIAOS] %s: FAILED - %s" prov-name (error-message-string err))))
        (setq i (1+ i))))
    (message "[AIAOS] Debug probe complete")))

;; ─── Input Handling ──────────────────────────────────────────────────────────

(defun aiaos-cli--handle-return ()
  "Handle Enter key press - send message to LLM."
  (interactive)
  (when aiaos-cli--mode-active
    (let ((input-start aiaos-cli--input-start)
          (input-end (point)))
      (when (and input-start (< input-start input-end))
        (let ((input (buffer-substring input-start input-end)))
          (delete-region input-start input-end)
          (insert "\n")
          (insert "[Thinking...]\n")
          (let ((response (aiaos-cli--llm-chat input)))
            (delete-region (point) (point-max))
            (insert (format "[Assistant] %s\n\n" response))
            (when aiaos-cli-show-tokens
              (insert "[Token usage shown]\n"))
            (insert "\n> "))
          (setq aiaos-cli--input-start (point)))))))

(defun aiaos-cli--insert-mode-line ()
  "Insert mode line at buffer start."
  (save-excursion
    (goto-char (point-min))
    (insert (format "[AIAOS] Provider: %s | Retry: %d/%d | Timeout: %ds\n\n"
                    (aiaos-cli--get-current-provider)
                    0 aiaos-cli-max-retry
                    aiaos-cli-timeout))
    (insert "> ")))

;; ─── Mode Definition ─────────────────────────────────────────────────────────

(define-derived-mode aiaos-cli-mode special-mode "AIAOS"
  "AIAOS CLI mode for interacting with LLM providers."
  (setq buffer-read-only nil)
  (setq aiaos-cli--mode-active t)
  (setq aiaos-cli--input-start (point))
  (aiaos-cli--insert-mode-line)
  (local-set-key (kbd "RET") #'aiaos-cli--handle-return)
  (local-set-key (kbd "C-m") #'aiaos-cli--handle-return)
  (local-set-key (kbd "C-c C-k") #'aiaos-cli--exit-mode)
  (local-set-key (kbd "C-c C-p") #'aiaos-cli--switch-provider)
  (local-set-key (kbd "C-c C-d") #'aiaos-cli--debug-probe)
  (local-set-key (kbd "C-c C-l") #'aiaos-cli--show-stats)
  (local-set-key (kbd "C-c C-r") #'aiaos-cli--reset-conversation))

(defun aiaos-cli--exit-mode ()
  "Exit AIAOS CLI mode."
  (interactive)
  (kill-buffer))

(defun aiaos-cli--switch-provider ()
  "Switch to next provider."
  (interactive)
  (aiaos-cli--advance-provider)
  (message "[AIAOS] Switched to provider: %s" (aiaos-cli--get-current-provider))
  (save-excursion
    (goto-char (point-min))
    (replace-regexp (format "Provider: [^|]*")
                    (format "Provider: %s" (aiaos-cli--get-current-provider)))))

(defun aiaos-cli--show-stats ()
  "Show provider statistics."
  (interactive)
  (with-current-buffer (get-buffer-create "*AIAOS Stats*")
    (erase-buffer)
    (insert "Provider Statistics:\n\n")
    (dolist (stat aiaos-cli--provider-stats)
      (insert (format "%-20s Attempts: %d  Success: %s  Last Error: %s\n"
                      (nth 0 stat)
                      (nth 1 stat)
                      (nth 2 stat)
                      (nth 3 stat))))
    (switch-to-buffer)))

(defun aiaos-cli--reset-conversation ()
  "Reset conversation history."
  (interactive)
  (setq aiaos-cli--conversation '())
  (message "[AIAOS] Conversation reset"))

;; ─── Entry Point ─────────────────────────────────────────────────────────────

(defun aiaos-cli ()
  "Start AIAOS CLI."
  (interactive)
  (aiaos-cli--load-providers)
  (when (null aiaos-cli--provider-order)
    (message "[AIAOS] Error: No providers configured")
    (return-from aiaos-cli))
  (setq aiaos-cli--current-provider-index 0)
  (let ((buf (get-buffer-create "*AIAOS CLI*")))
    (switch-to-buffer buf)
    (erase-buffer)
    (aiaos-cli-mode)
    (insert "\nType your message and press Enter to send.\n")
    (insert "Commands: C-c C-k (quit), C-c C-p (switch provider), C-c C-d (debug probe)\n\n")
    (insert "> ")))

;; ─── Initialization ──────────────────────────────────────────────────────────

(defun aiaos-cli-init ()
  "Initialize AIAOS CLI."
  (aiaos-cli--load-providers)
  (message "[AIAOS] Initialized. Use 'M-x aiaos-cli' to start."))

(defalias 'aiaos 'aiaos-cli)

(provide 'aiaos-cli)

