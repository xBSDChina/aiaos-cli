;;; aiaos-cli.el --- AIAOS CLI for Emacs -*- lexical-binding: t -*-

;; Version: 6.2.0 (Simplified LLM interaction: 30s timeout as probe window)

(require 'json)
(require 'cl-lib)

;; ─── Utilities ───────────────────────────────────────────────────────────────

(defun aiaos-cli--trim (str)
  "Return STR with leading and trailing whitespace removed."
  (string-trim str))

(defun aiaos-cli--json-file-to-elisp (path)
  "Parse JSON file at PATH and return Elisp data with hash tables using symbol keys."
  (let ((result))
    (with-temp-buffer
      (insert-file-contents path)
      (goto-char (point-min))
      (setq result (json-read)))
    (aiaos-cli--convert-keys-to-symbols result)))

(defun aiaos-cli--elisp-to-json-string (data)
  "Convert ELISP data (with plists) to JSON string."
  (json-encode data))

(defun aiaos-cli--convert-keys-to-symbols (obj)
  "Recursively convert JSON data to hash tables with symbol keys."
  (cond
   ((hash-table-p obj)
    (let ((result (make-hash-table :test 'equal)))
      (maphash (lambda (k v)
                 (puthash (if (stringp k) (intern k) k)
                          (aiaos-cli--convert-keys-to-symbols v)
                          result))
               obj)
      result))
   ((listp obj)
    (if (and (consp obj) (consp (car obj)) (atom (car (car obj))))
        ;; It's a plist: ((key . value) ...)
        (let ((result (make-hash-table :test 'equal)))
          (dolist (pair obj)
            (when (and (consp pair) (atom (car pair)))
              (puthash (if (stringp (car pair)) (intern (car pair)) (car pair))
                       (aiaos-cli--convert-keys-to-symbols (cdr pair))
                       result)))
          result)
      (mapcar #'aiaos-cli--convert-keys-to-symbols obj)))
   (t obj)))

(defun aiaos-cli--json-string-to-elisp (str)
  "Parse JSON string STR and return Elisp data with hash tables using symbol keys."
  (let ((result))
    (with-temp-buffer
      (insert str)
      (goto-char (point-min))
      (setq result (json-read)))
    (aiaos-cli--convert-keys-to-symbols result)))

(defun aiaos-cli--plist-get (plist key)
  "Get value for KEY from PLIST."
  (plist-get plist key))

(defun aiaos-cli--log-error (msg)
  "Log error message MSG to error log file."
  (let ((log-file (expand-file-name aiaos-cli-error-log-file)))
    (when (file-directory-p (file-name-directory log-file))
      (with-current-buffer (find-file-noselect log-file)
        (goto-char (point-max))
        (insert (format "[%s] %s\n" (current-time-string) msg)))
      (save-buffer))))

